<% content_for :title, "Calendar" %>
<div class="calendar-layout" data-controller="calendar"
     data-calendar-events-url-value="<%= api_v1_events_path %>"
     data-calendar-tasks-url-value="<%= api_v1_tasks_path %>"
     data-calendar-jots-url-value="<%= api_v1_jots_path %>"
     data-calendar-new-url-value="<%= new_event_path %>"
     data-calendar-date-value="<%= params[:date] %>"
     data-calendar-view-value="<%= params[:view] %>"
     data-calendar-day-start-value="<%= Organizer.day_start %>"
     data-calendar-day-end-value="<%= Organizer.day_end %>">
  <section class="card calendar-card">
    <div data-calendar-target="calendar" class="calendar"></div>
    <p class="muted small cal-hint">Shaded "Free" spaces are the open time in your day. Drag a task or a jot into one to block time for it, and drag or stretch blocks to move them. Tap an empty time to add an event.</p>
  </section>
  <aside class="card unscheduled" data-calendar-target="tasks">
    <h2>To schedule</h2>
    <p class="muted small">Open tasks without a time block. Drag one onto the calendar.</p>
    <ul class="drag-list">
      <% @unscheduled.each do |t| %>
        <li class="drag-task" data-task-id="<%= t.id %>" data-title="<%= t.title %>" data-minutes="<%= t.estimate_minutes || 30 %>"
            style="--chip: <%= t.project&.color || 'var(--accent)' %>">
          <span class="grip" aria-hidden="true">⋮⋮</span>
          <span class="drag-title"><%= t.title %></span>
          <span class="muted small"><%= t.estimate_minutes || 30 %>m<% if t.due_date %> · <%= due_label(t) %><% end %></span>
          <% if t.notes.present? %><span class="drag-notes"><%= t.notes.truncate(90) %></span><% end %>
        </li>
      <% end %>
    </ul>
    <% if @unscheduled.empty? %><p class="empty">Everything open has a time block.</p><% end %>

    <% if @jots.any? %>
      <h2 class="drag-section">Jots</h2>
      <p class="muted small">Drop a jot on the calendar to make it a task and block 30 minutes for it.</p>
      <ul class="drag-list">
        <% @jots.each do |j| %>
          <li class="drag-task is-jot" data-jot-id="<%= j.id %>" data-title="<%= j.title_line %>" data-minutes="30">
            <span class="grip" aria-hidden="true">⋮⋮</span>
            <span class="drag-title"><%= j.title_line %></span>
            <span class="muted small">Jot</span>
            <% if j.rest.present? %><span class="drag-notes"><%= j.rest.truncate(90) %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </aside>
</div>
