<div class="auth-logo"><%= icon("logo", size: 36) %></div>
<h1>Life Organizer</h1>
<p class="muted">Sign in with your app password.</p>
<%= form_with url: login_path, class: "form" do %>
  <label>Password <%= password_field_tag :password, nil, required: true, autofocus: true, autocomplete: "current-password" %></label>
  <div class="actions"><%= submit_tag "Sign in", class: "btn primary wide" %></div>
<% end %>
