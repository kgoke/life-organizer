# Copy to .env and fill in. Never commit .env.

# The password for the web app and for approving Claude's connection. Use a long one.
ADMIN_PASSWORD=change-me-to-something-long

# The address you'll reach the app at, as Claude will see it (https, no trailing slash).
PUBLIC_URL=https://organizer.example.com

# Your time zone (IANA name), and the working hours used for free-time search.
APP_TIMEZONE=America/New_York
DAY_START=08:00
DAY_END=18:00

# Set to true when the app is reached over HTTPS (through a tunnel or proxy).
ASSUME_SSL=true
FORCE_SSL=false

# Let Claude connect with OAuth (needed for claude.ai custom connectors). API keys work either way.
OAUTH_ENABLED=true

# Optional. Leave blank and one is made and kept in the data volume.
SECRET_KEY_BASE=

# Optional: the port on this machine, and a Cloudflare Tunnel token for the "tunnel" profile.
HOST_PORT=3000
CLOUDFLARE_TUNNEL_TOKEN=
